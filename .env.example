# Copy to .env and fill in. Never commit .env.
#
# Payment, email and Google sign-in keys can be left empty here and set in
# Admin → Settings instead (saved encrypted). A key saved in admin takes
# priority over the variable below.

# --- Required: the app can't start without these -------------------------

# Postgres (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_DATABASE_URL=

# Signs logins, and encrypts keys saved in Admin → Settings.
# Generate with: npx auth secret
# Changing it signs everyone out and makes saved admin keys unreadable
# (the admin page then asks for them again).
AUTH_SECRET=

# Public address of the site, e.g. https://yourstore.ph
NEXT_PUBLIC_SERVER_URL=

# Product image uploads in admin (uploadthing.com)
UPLOADTHING_TOKEN=

# --- Optional -------------------------------------------------------------

# Encrypt admin-saved keys with their own key instead of one derived from
# AUTH_SECRET, so AUTH_SECRET can be rotated without re-entering them
SETTINGS_ENCRYPTION_KEY=

# Only needed when running `next start` yourself (not on Vercel)
# AUTH_TRUST_HOST=true

# Error tracking (sentry.io); the auth token, org and project upload
# source maps during builds
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Or set in Admin → Settings ---------------------------------------------

# Payments (PayMongo)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated: PayMongo, CashOnDelivery
PAYMENT_METHODS=
DEFAULT_PAYMENT_METHOD=
# Comma-separated: gcash, paymaya, card, qrph
PAYMONGO_PAYMENT_METHODS=

# Email (Resend); without a key, emails are written to the server log
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Sign in with Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shipping (Admin → Settings → Shipping)
SHIPPING_FEE=
FREE_SHIPPING_MIN=

# --- Or set in Site Studio ----------------------------------------------------

# Fallbacks until Site Studio → Branding is saved
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=
